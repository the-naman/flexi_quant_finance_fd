{
  "datasets": [
    {
      "name": "flow",
      "displayName": "Money in and out",
      "queryLines": [
        "SELECT branch, product,\n",
        "       sum(CASE WHEN event_type = 'disbursement' THEN amount ELSE 0 END) AS disbursed,\n",
        "       sum(CASE WHEN event_type = 'repayment' THEN amount ELSE 0 END) AS collected,\n",
        "       sum(CASE WHEN event_type = 'repayment' THEN interest ELSE 0 END) AS interest_earned,\n",
        "       sum(CASE WHEN event_type = 'late_fee' THEN amount ELSE 0 END) AS late_fees\n",
        "FROM fqf_dev.gold.v_fqf_portfolio_daily\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "book",
      "displayName": "Loan book today",
      "queryLines": [
        "SELECT branch, product,\n",
        "       sum(CASE WHEN status = 'active' THEN loans ELSE 0 END) AS active_loans,\n",
        "       sum(outstanding) AS outstanding,\n",
        "       sum(CASE WHEN dpd_bucket <> 'current' THEN outstanding ELSE 0 END) AS overdue_outstanding\n",
        "FROM fqf_dev.gold.v_fqf_loan_book\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "month",
      "displayName": "Disbursed, due and collected by month",
      "queryLines": [
        "SELECT year_month, branch, product,\n",
        "       CASE event_type WHEN 'disbursement' THEN 'disbursed' WHEN 'emi_due' THEN 'due' ELSE 'collected' END AS measure,\n",
        "       sum(amount) AS amount\n",
        "FROM fqf_dev.gold.v_fqf_portfolio_daily\n",
        "WHERE event_type IN ('disbursement', 'emi_due', 'repayment')\n",
        "  AND date <= (SELECT CASE WHEN max(date) = last_day(max(date)) THEN max(date)\n",
        "                           ELSE last_day(add_months(max(date), -1)) END FROM fqf_dev.gold.v_fqf_portfolio_daily)   -- complete months only\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "bucket",
      "displayName": "Outstanding by overdue bucket",
      "queryLines": [
        "SELECT dpd_bucket, branch, product, sum(outstanding) AS outstanding\n",
        "FROM fqf_dev.gold.v_fqf_loan_book WHERE status = 'active'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "purpose",
      "displayName": "Disbursed by purpose",
      "queryLines": [
        "SELECT branch, product,\n",
        "       CASE WHEN is_hospital_bill THEN 'BHG hospital bill' ELSE 'other' END AS purpose,\n",
        "       sum(amount) AS disbursed\n",
        "FROM fqf_dev.gold.v_fqf_portfolio_daily WHERE event_type = 'disbursement'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "score",
      "displayName": "Loans by credit score band",
      "queryLines": [
        "SELECT coalesce(score_band, 'unknown') AS score_band, status, branch, product, sum(loans) AS loans\n",
        "FROM fqf_dev.gold.v_fqf_loan_book\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "pay_day",
      "displayName": "Payments per day (30 days)",
      "queryLines": [
        "SELECT date_format(day, 'yyyy-MM-dd') AS day, status, sum(events) AS events\n",
        "FROM fqf_dev.gold.v_fqf_payments_live\n",
        "WHERE day >= date_sub(current_date(), 29)\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "pay_7",
      "displayName": "Payments, last 7 days",
      "queryLines": [
        "SELECT method, lpad(CAST(hour_ist AS STRING), 2, '0') AS hour_ist,\n",
        "       sum(events) AS events,\n",
        "       sum(CASE WHEN status = 'failed' THEN events ELSE 0 END) AS failed,\n",
        "       sum(CASE WHEN status = 'failed' THEN amount ELSE 0 END) AS failed_amount\n",
        "FROM fqf_dev.gold.v_fqf_payments_live\n",
        "WHERE day >= date_sub(current_date(), 6)\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "alerts_7",
      "displayName": "Velocity alerts, last 7 days",
      "queryLines": [
        "SELECT date_format(window_start_ist, 'dd MMM HH:mm') AS window_ist, customer_ref,\n",
        "       failed_payments, failed_amount, 1 AS alert\n",
        "FROM fqf_dev.gold.v_fqf_payment_alerts\n",
        "WHERE window_start_ist >= date_sub(current_date(), 6)\n"
      ]
    }
  ],
